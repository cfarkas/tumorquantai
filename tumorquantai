def _configured_backend() -> str:
    value = os.environ.get("TUMORQUANTAI_BACKEND", "").strip().casefold()
    if value in {"docker", "singularity", "conda", "local"}:
        return value
    for path in (
        Path.home() / ".config/tumorquantai/backend",
        Path("/etc/tumorquantai/backend"),
    ):
        try:
            value = path.read_text(encoding="utf-8").strip().casefold()
        except OSError:
            continue
        if value in {"docker", "singularity", "conda", "local"}:
            return value
    return "docker"


def _install_command(command: Sequence[str], *, env: Mapping[str, str] | None = None) -> None:
    print("$ " + shlex.join([str(item) for item in command]))
    completed = subprocess.run(list(command), env=dict(env) if env else None, check=False)
    if completed.returncode != 0:
        raise core.TumorQuantAIError(
            f"Installation command failed with exit code {completed.returncode}: "
            + shlex.join([str(item) for item in command]),
            core.EXIT_PREFLIGHT,
        )


def _venv_python(environment: Path) -> Path:
    return environment / "bin/python"


def _prepare_python_environment(environment: Path) -> Path:
    python = _venv_python(environment)
    if not python.is_file():
        environment.parent.mkdir(parents=True, exist_ok=True)
        _install_command([sys.executable, "-m", "venv", str(environment)])
    _install_command([str(python), "-m", "pip", "install", "--upgrade", "pip"])
    _install_command([
        str(python), "-m", "pip", "install", "--requirement",
        str(ROOT / "requirements-tutorial.txt"),
    ])
    return python


def _prepare_poetry_environment(state_dir: Path) -> Path:
    tool_environment = state_dir / "poetry-tool"
    poetry_python = _venv_python(tool_environment)
    if not poetry_python.is_file():
        _install_command([sys.executable, "-m", "venv", str(tool_environment)])
    _install_command([
        str(poetry_python), "-m", "pip", "install", "--upgrade", "pip",
        "poetry>=2,<3",
    ])
    poetry = tool_environment / "bin/poetry"
    environment = os.environ.copy()
    environment["POETRY_VIRTUALENVS_IN_PROJECT"] = "true"
    _install_command([str(poetry), "install", "--no-interaction"], env=environment)
    python = ROOT / ".venv/bin/python"
    if not python.is_file():
        raise core.TumorQuantAIError(
            "Poetry did not create the expected in-project environment.",
            core.EXIT_PREFLIGHT,
        )
    return python


def _install_nextflow(bin_dir: Path, *, allow_download: bool) -> Path | None:
    existing = shutil.which("nextflow")
    if existing:
        return Path(existing).resolve()
    target = bin_dir / "nextflow"
    if target.is_file():
        return target
    if not allow_download:
        return None
    print(f"Downloading pinned Nextflow {NEXTFLOW_VERSION}...")
    try:
        with urllib.request.urlopen(NEXTFLOW_URL, timeout=60) as response:
            payload = response.read()
    except OSError as exc:
        raise core.TumorQuantAIError(
            f"Could not download Nextflow: {exc}", core.EXIT_PREFLIGHT
        ) from exc
    digest = hashlib.sha256(payload).hexdigest()
    if digest != NEXTFLOW_SHA256:
        raise core.TumorQuantAIError(
            "Downloaded Nextflow checksum did not match the pinned release.",
            core.EXIT_DATA,
        )
    bin_dir.mkdir(parents=True, exist_ok=True)
    temporary = target.with_suffix(".tmp")
    temporary.write_bytes(payload)
    temporary.chmod(0o755)
    os.replace(temporary, target)
    return target


def _java_major() -> int | None:
    if shutil.which("java") is None:
        return None
    completed = subprocess.run(
        ["java", "-version"], text=True,
        stdout=subprocess.PIPE, stderr=subprocess.STDOUT, check=False,
    )
    match = re.search(r'version "([0-9]+)', completed.stdout)
    return int(match.group(1)) if match else None


def _backend_issues(method: str) -> list[str]:
    issues: list[str] = []
    if method in {"docker", "poetry"}:
        if shutil.which("docker") is None:
            issues.append("Docker is not installed: https://docs.docker.com/engine/install/")
        else:
            result = subprocess.run(
                ["docker", "info"], stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL, check=False,
            )
            if result.returncode != 0:
                issues.append("Docker is installed but its daemon is not accessible.")
    elif method == "singularity":
        if shutil.which("apptainer") is None and shutil.which("singularity") is None:
            issues.append(
                "Install Apptainer or Singularity: "
                "https://apptainer.org/docs/admin/main/installation.html"
            )
    elif method == "conda":
        if shutil.which("conda") is None:
            issues.append(
                "Conda is not installed; install Miniforge: "
                "https://github.com/conda-forge/miniforge"
            )
    java = _java_major()
    if java is None:
        issues.append("Java is not installed; install Java 17 or newer.")
    elif java < 17:
        issues.append(f"Java {java} is too old; install Java 17 or newer.")
    return issues


def cmd_install(args: argparse.Namespace) -> int:
    method = args.install_method
    if args.system and args.prefix is not None:
        raise core.TumorQuantAIError(
            "Use either --system or --prefix, not both.", core.EXIT_USAGE
        )
    prefix = (
        Path("/usr/local") if args.system
        else (args.prefix or Path.home() / ".local")
    ).expanduser().resolve()
    state_dir = (
        Path("/usr/local/share/tumorquantai") if args.system
        else Path.home() / ".local/share/tumorquantai"
    )
    bin_dir = prefix / "bin"
    config_dir = Path("/etc/tumorquantai") if args.system else Path.home() / ".config/tumorquantai"
    wrapper = bin_dir / "tumorquantai"
    backend = "docker" if method == "poetry" else method

    print("TumorQuantAI installation plan:")
    print(f"  repository: {ROOT}")
    print(f"  method:     {method}")
    print(f"  command:    {wrapper}")
    print(f"  state:      {state_dir}")
    if args.dry_run:
        print("Dry run complete; no files or environments were changed.")
        return core.EXIT_OK

    try:
        bin_dir.mkdir(parents=True, exist_ok=True)
        state_dir.mkdir(parents=True, exist_ok=True)
        config_dir.mkdir(parents=True, exist_ok=True)
    except PermissionError as exc:
        raise core.TumorQuantAIError(
            "The selected installation prefix is not writable. Use the default "
            "user installation or rerun with sudo and --system.",
            core.EXIT_PREFLIGHT,
        ) from exc

    python = (
        _prepare_poetry_environment(state_dir)
        if method == "poetry"
        else _prepare_python_environment(state_dir / "venv")
    )
    nextflow = _install_nextflow(
        bin_dir, allow_download=not args.no_nextflow_download
    )

    wrapper_text = "\n".join((
        "#!/usr/bin/env bash",
        "set -Eeuo pipefail",
        f"export TUMORQUANTAI_REPO={shlex.quote(str(ROOT))}",
        f"export TUMORQUANTAI_BACKEND={shlex.quote(backend)}",
        f"export PATH={shlex.quote(str(bin_dir))}:\"$PATH\"",
        f"exec {shlex.quote(str(python))} {shlex.quote(str(ROOT / 'tumorquantai'))} \"$@\"",
        "",
    ))
    core.atomic_text(wrapper, wrapper_text, mode=0o755)
    core.atomic_text(config_dir / "repository", str(ROOT) + "\n", mode=0o644)
    core.atomic_text(config_dir / "backend", backend + "\n", mode=0o644)

    issues = _backend_issues(method)
    if nextflow is None:
        issues.append(
            "Nextflow is not installed. Rerun without --no-nextflow-download "
            "or install Nextflow 24.10 or newer."
        )

    print(f"Installed command: {wrapper}")
    if str(bin_dir) not in os.environ.get("PATH", "").split(os.pathsep):
        print(f'For this terminal, run: export PATH="{bin_dir}:$PATH"')
    if issues:
        print("The TumorQuantAI command is installed, but this route is not ready:")
        for issue in issues:
            print(f"  - {issue}")
        return core.EXIT_PREFLIGHT
    print(f"Installation and {method} readiness checks passed.")
    print("Next: tumorquantai quickstart --no-inference")
    return core.EXIT_OK



def cmd_convert(args: argparse.Namespace) -> int:
    """Run the maintained MDS converter through the installed Python environment."""
    command = [
        sys.executable,
        str(ROOT / "bin/mds_to_tiff.py"),
        "--input", str(args.input.expanduser()),
        "--output-dir", str(args.output.expanduser()),
        "--levels", *(str(level) for level in args.levels),
        "--compression", args.compression,
        "--compression-level", str(args.compression_level),
    ]
    if args.manifest is not None:
        command.extend(["--manifest", str(args.manifest.expanduser())])
    for sample_id in args.sample_id:
        command.extend(["--sample-id", sample_id])
    if args.expected_count is not None:
        command.extend(["--expected-count", str(args.expected_count)])
    if args.source_mpp is not None:
        command.extend(["--source-mpp", f"{args.source_mpp:.15g}"])
    if args.resume:
        command.append("--resume")
    elif args.overwrite:
        command.append("--overwrite")
    if args.dry_run:
        command.append("--dry-run")
    print("Running the installed TumorQuantAI MDS converter:")
    print(f"  {core.shell_join(command)}")
    completed = subprocess.run(command, check=False)
    return int(completed.returncode)


def _default_quickstart_output() -> Path:
    configured = os.environ.get("TUMORQUANTAI_DATA_ROOT", "").strip()
    if configured:
        return Path(configured).expanduser().resolve() / "quickstart-one-wsi"
    return ROOT.parent / "tumorquantai-quickstart-one-wsi"

def add_execution_profile_options(command: argparse.ArgumentParser) -> None:
    """Add execution aliases without removing the compatible profile option."""
    execution = command.add_mutually_exclusive_group()
    execution.add_argument(
        "--profile", choices=("auto", "gpu", "cpu", "local"),
        help="execution profile (default: auto)",
    )
    execution.add_argument(
        "--cpu", dest="profile", action="store_const", const="cpu",
        help="force CPU execution (same as --profile cpu)",
    )
    execution.add_argument(
        "--gpu", dest="profile", action="store_const", const="gpu",
        help="select the NVIDIA GPU profile (same as --profile gpu)",
    )
    command.set_defaults(profile="auto")


def add_execution_backend_options(command: argparse.ArgumentParser) -> None:
    """Add mutually exclusive software-runtime aliases."""
    backend = command.add_mutually_exclusive_group()
    backend.add_argument(
        "--backend", choices=("docker", "singularity", "conda", "local"),
        help="software backend (default: docker)",
    )
    backend.add_argument(
        "--docker", dest="backend", action="store_const", const="docker",
        help="run scientific tasks with Docker",
    )
    backend.add_argument(
        "--singularity", "--apptainer", dest="backend", action="store_const",
        const="singularity", help="run scientific tasks with Singularity or Apptainer",
    )
    backend.add_argument(
        "--conda", dest="backend", action="store_const", const="conda",
        help="let Nextflow create and reuse the versioned Conda environment",
    )
    command.set_defaults(backend=_configured_backend())


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="tumorquantai",
        description=(
            "Run, inspect, convert, and understand TumorQuantAI without "
            "assembling a long Nextflow command."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=(
            "Examples:\n"
            "  tumorquantai demo\n"
            "  tumorquantai inspect /data/slides --output /data/tqa-inspection\n"
            "  tumorquantai convert downloads --output slides --resume\n"
            "  tumorquantai quickstart --no-inference"
        ),
    )
    parser.add_argument("--version", action="version", version=f"TumorQuantAI {core.VERSION}")
    subparsers = parser.add_subparsers(dest="command", required=True)

    install = subparsers.add_parser(
        "install",
        help="install the global command and prepare one execution method",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    route = install.add_mutually_exclusive_group(required=True)
    route.add_argument(
        "--docker", dest="install_method", action="store_const", const="docker",
        help="install the launcher and validate Docker",
    )
    route.add_argument(
        "--singularity", "--apptainer", dest="install_method",
        action="store_const", const="singularity",
        help="install the launcher and validate Singularity/Apptainer",
    )
    route.add_argument(
        "--poetry", dest="install_method", action="store_const", const="poetry",
        help="install the Poetry-managed launcher; Docker is the default backend",
    )
    route.add_argument(
        "--conda", dest="install_method", action="store_const", const="conda",
        help="install the launcher and validate Miniforge/Conda",
    )
    install.add_argument(
        "--prefix", type=Path,
        help="user installation prefix (default: ~/.local)",
    )
    install.add_argument(
        "--system", action="store_true",
        help="install under /usr/local and /etc; normally run with sudo",
    )
    install.add_argument(
        "--no-nextflow-download", action="store_true",
        help="do not download the pinned Nextflow launcher when it is absent",
    )
    install.add_argument(
        "--dry-run", action="store_true",
        help="print the installation plan without changing files",
    )

    doctor = subparsers.add_parser("doctor", help="check the computer without inference")
    doctor.add_argument("--input", type=Path, help="optional input path to check")
    doctor.add_argument("--output", type=Path, help="optional output mount to check")
    doctor.add_argument("--work-dir", type=Path, help="optional Nextflow work directory")
    doctor.add_argument("--online", action="store_true", help="also check public GitHub, Zenodo, and model metadata")
    doctor.add_argument("--json", action="store_true", help="print redacted machine-readable JSON")
    doctor.add_argument("--token-file", type=Path, help=argparse.SUPPRESS)
    doctor.add_argument("--local-weight", type=Path, help=argparse.SUPPRESS)

    demo = subparsers.add_parser("demo", help="run the bundled structural test")
    demo.add_argument("--output", "--outdir", type=Path, default=Path("tumorquantai-demo"), help="small demo result directory (default: tumorquantai-demo)")


    convert = subparsers.add_parser(
        "convert",
        help="convert verified Motic MDS files to resumable L0/L2 TIFF files",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    convert.add_argument(
        "input", type=Path,
        help="MDS file, legacy raw tree, or directory containing MDS files",
    )
    convert.add_argument(
        "--output", "--output-dir", dest="output", required=True, type=Path,
        help="directory for converted TIFF files and samples.csv",
    )
    convert.add_argument(
        "--manifest", type=Path,
        help="authoritative public MDS manifest used for integrity checks",
    )
    convert.add_argument("--levels", nargs="+", type=int, default=[0, 2])
    convert.add_argument(
        "--sample-id", action="append", default=[],
        help="convert only this public alias; repeatable",
    )
    convert.add_argument(
        "--expected-count", type=int,
        help="fail unless exactly this many slides are selected",
    )
    convert.add_argument(
        "--source-mpp", type=positive_float,
        help="source micrometres per pixel; must match the manifest when both are used",
    )
    convert.add_argument("--compression", default="deflate")
    convert.add_argument("--compression-level", type=int, default=6)
    convert_mode = convert.add_mutually_exclusive_group()
    convert_mode.add_argument(
        "--resume", action="store_true",
        help="reuse only TIFFs verified by the conversion manifest",
    )
    convert_mode.add_argument(
        "--overwrite", action="store_true",
        help="replace selected converted files and manifest entries",
    )
    convert.add_argument(
        "--dry-run", action="store_true",
        help="validate selection and print the conversion plan without writing TIFF files",
    )

    inspect = subparsers.add_parser("inspect", help="inspect slides without inference or model access")
    inspect.add_argument("input", type=Path, help="directory containing exported L0 slides")
    inspect.add_argument("--output", "--outdir", type=Path, required=True, help="inspection result directory")
    inspect.add_argument("--source-mpp", type=positive_float, help="verified source L0 micrometres per pixel")
    inspect.add_argument("--sample-sheet", type=Path, help="CSV/TSV with sample_id and slide_path")
    inspect.add_argument("--pattern", action="append", default=[], help="primary-slide glob; repeatable")
    inspect.add_argument("--include", default="*", help="sample-ID glob to include")
    inspect.add_argument("--exclude", default="", help="sample-ID glob to exclude")

    run = subparsers.add_parser(
        "run", help="run a smoke, fast, or full analysis",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    suppressed = argparse.SUPPRESS

    inputs = run.add_argument_group("Input and sample selection")
    inputs.add_argument("input", nargs="?", metavar="INPUT", default=suppressed, help="directory containing exported L0 slides (or set input_dir in --params-file)")
    inputs.add_argument("--output", "--outdir", type=Path, default=suppressed, help="result directory on a verified mounted storage filesystem (or set output_dir in --params-file)")
    inputs.add_argument("--sample-sheet", type=Path, default=suppressed, help="CSV or TSV mapping sample_id to slide_path")
    inputs.add_argument("--pattern", action="append", default=suppressed, help="primary-slide glob; repeat for multiple patterns")
    inputs.add_argument("--include", default=suppressed, help="sample-ID glob to include")
    inputs.add_argument("--exclude", default=suppressed, help="sample-ID glob to exclude")
    inputs.add_argument("--sample", default=suppressed, help="single sample ID selected by the smoke preset")
    inputs.add_argument("--dry-run", action="store_true", default=suppressed, help="run discovery only; no HistoPLUS inference")
    inputs.add_argument("--params-file", type=Path, default=suppressed, help="YAML or JSON parameters; explicit CLI flags take precedence")

    sampling = run.add_argument_group("Sampling and image scale")
    sampling.add_argument("--preset", choices=("smoke", "fast", "full"), default="smoke", help="named 1%%, 10%%, or 100%% defaults")
    sampling.add_argument("--mpp", "--target-mpp", type=positive_float, default=suppressed, help="target model resolution in micrometres per pixel")
    sampling.add_argument("--source-mpp", "--slide-mpp", type=positive_float, default=suppressed, help="verified source L0 micrometres per pixel")
    sampling.add_argument("--percent-slide", type=float, default=suppressed, help="percentage of detected tissue tiles in (0, 100]")
    sampling.add_argument("--seed", "--patch-random-seed", type=int, default=core.DEFAULT_SEED, help="deterministic sampling seed")
    sampling.add_argument("--max-sampled-patches", type=int, default=suppressed, help="maximum sampled patches exported; 0 means no cap")
    sampling.add_argument("--collage", default=suppressed, help="square sampled-patch collage such as 4x4")

    tiling = run.add_argument_group("Tiling and tissue filtering")
    tiling.add_argument("--tile-px", type=int, default=suppressed, help="requested model-tile edge in pixels")
    tiling.add_argument("--overlap", type=float, default=suppressed, help="tile overlap ratio from 0 to 1")
    tiling.add_argument("--background-fraction", type=float, default=suppressed, help="maximum background ratio for retained tiles")

    execution = run.add_argument_group("Execution profile and resources")
    add_execution_profile_options(execution)
    add_execution_backend_options(execution)
    execution.add_argument("--device", default=suppressed, help="worker inference device: auto, cpu, gpu, cuda, or cuda:N")
    execution.add_argument("--cpus", type=int, default=suppressed, help="CPU cores requested per slide task")
    execution.add_argument("--memory", default=suppressed, help="memory requested per slide task, for example '32 GB'")
    execution.add_argument("--time", default=suppressed, help="time limit per slide task, for example 120h")
    execution.add_argument("--max-parallel-slides", type=int, default=suppressed, help="maximum concurrent slide tasks")
    execution.add_argument("--num-workers", type=int, default=suppressed, help="data-loader worker processes per slide")
    execution.add_argument("--shm-size", "--docker-shm-size", dest="docker_shm_size", default=suppressed, help="Docker shared-memory size, for example 2g")

    model = run.add_argument_group("HistoPLUS model settings")
    model.add_argument("--celltypes-batch-size", type=int, default=suppressed, help="HistoPLUS typing batch size")
    model.add_argument("--histoplus-magnification", choices=("20x", "40x"), default=suppressed, help="HistoPLUS model magnification")
    model.add_argument("--histoplus-revision", default=suppressed, help="reviewed immutable 40-hex HistoPLUS commit")
    model.add_argument("--local-weight", "--histoplus-weight-file", dest="local_weight", type=Path, default=suppressed, help="authorized local HistoPLUS weight file")
    model.add_argument("--histoplus-cache-dir", default=suppressed, help="HistoPLUS cache path inside the task environment")
    amp_group = model.add_mutually_exclusive_group()
    amp_group.add_argument("--amp", dest="amp", action="store_true", default=suppressed, help="enable automatic mixed precision")
    amp_group.add_argument("--no-amp", dest="amp", action="store_false", default=suppressed, help="disable automatic mixed precision")

    cells = run.add_argument_group("Optional cell segmentation")
    cell_stage = cells.add_mutually_exclusive_group()
    cell_stage.add_argument("--run-cells-stage", dest="run_cells_stage", action="store_true", default=suppressed, help="run optional cell segmentation")
    cell_stage.add_argument("--no-run-cells-stage", dest="run_cells_stage", action="store_false", default=suppressed, help="skip optional cell segmentation")
    cells.add_argument("--cells-model", default=suppressed, help="optional cell-segmentation model name")
    cells.add_argument("--cells-batch-size", type=int, default=suppressed, help="optional cell-segmentation batch size")

    pyramidal = run.add_argument_group("Pyramidal TIFF conversion")
    convert = pyramidal.add_mutually_exclusive_group()
    convert.add_argument("--convert-to-pyramidal", dest="convert_to_pyramidal", action="store_true", default=suppressed, help="convert non-pyramidal input TIFF files")
    convert.add_argument("--no-convert-to-pyramidal", dest="convert_to_pyramidal", action="store_false", default=suppressed, help="use input TIFF files directly")
    pyramidal.add_argument("--pyramidal-tile", type=int, default=suppressed, help="pyramidal BigTIFF tile edge in pixels")
    pyramidal.add_argument("--pyramidal-compression", choices=("none", "lzw", "deflate", "zstd", "jpeg"), default=suppressed, help="pyramidal BigTIFF compression")
    pyramidal.add_argument("--pyramidal-jpeg-q", type=int, default=suppressed, help="JPEG quality from 1 to 100")

    overlays = run.add_argument_group("Overlays and figures")
    overlays.add_argument("--zoom-size", type=int, default=suppressed, help="automatic zoom-window edge in level-0 pixels")
    overlays.add_argument("--overlay-alpha", type=float, default=suppressed, help="filled-overlay opacity from 0 to 1")
    overlays.add_argument("--overlay-style", choices=("filled", "outline", "centroid", "outline_centroid", "filled_outline", "filled-outline"), default=suppressed, help="cell-type overlay style")
    overlays.add_argument("--overlay-outline-width", type=int, default=suppressed, help="color-outline width in pixels")
    overlays.add_argument("--overlay-halo-width", type=int, default=suppressed, help="black-halo width in pixels")
    overlays.add_argument("--overlay-draw-order", choices=("input", "small-last", "large-last"), default=suppressed, help="polygon drawing order")
    overlays.add_argument("--cell-marker-radius", type=int, default=suppressed, help="centroid-marker radius in pixels; 0 disables markers")
    overlays.add_argument("--figure-dpi", type=int, default=suppressed, help="raster figure dots per inch")
    overlays.add_argument("--qc-patch-count", type=int, default=suppressed, help="dense quality-control patch overlays per slide")
    overlays.add_argument("--qc-patch-size", type=int, default=suppressed, help="quality-control patch edge in level-0 pixels")

    exports = run.add_argument_group("Output formats and exports")
    coordinates = exports.add_mutually_exclusive_group()
    coordinates.add_argument("--plain-csv", dest="plain_csv", action="store_true", default=suppressed, help="write uncompressed coordinate CSV files")
    coordinates.add_argument("--compressed-coordinates", dest="plain_csv", action="store_false", default=suppressed, help="write coordinate CSV files with gzip compression")
    qupath = exports.add_mutually_exclusive_group()
    qupath.add_argument("--export-qupath", dest="export_qupath", action="store_true", default=suppressed, help="write QuPath-compatible annotations")
    qupath.add_argument("--no-export-qupath", dest="export_qupath", action="store_false", default=suppressed, help="skip QuPath export")
    json_export = exports.add_mutually_exclusive_group()
    json_export.add_argument("--save-json", dest="save_json", action="store_true", default=suppressed, help="write the optional per-cell JSON export")
    json_export.add_argument("--no-save-json", dest="save_json", action="store_false", default=suppressed, help="skip the optional per-cell JSON export")
    exports.add_argument("--log-level", choices=("DEBUG", "INFO", "WARNING", "ERROR"), default=suppressed, help="worker log verbosity")

    retry = run.add_argument_group("Retry, resume, and aggregation")
    retry.add_argument("--max-retries", type=int, default=suppressed, help="retry attempts after the first failed task")
    failure = retry.add_mutually_exclusive_group()
    failure.add_argument("--continue-on-error", dest="continue_on_error", action="store_true", default=suppressed, help="continue after a slide exhausts retries")
    failure.add_argument("--fail-fast", dest="continue_on_error", action="store_false", default=suppressed, help="stop after a slide exhausts retries")
    mixed = retry.add_mutually_exclusive_group()
    mixed.add_argument("--allow-mixed-sampling", dest="allow_mixed_sampling", action="store_true", default=suppressed, help="allow aggregation across different sampling settings")
    mixed.add_argument("--no-allow-mixed-sampling", dest="allow_mixed_sampling", action="store_false", default=suppressed, help="require consistent sampling settings")
    resume = retry.add_mutually_exclusive_group()
    resume.add_argument("--resume", dest="resume", action="store_true", default=suppressed, help="reuse valid cached Nextflow tasks")
    resume.add_argument("--no-resume", dest="resume", action="store_false", default=suppressed, help="disable Nextflow cache reuse")

    paths = run.add_argument_group("Cache, container, and work paths")
    paths.add_argument("--container-image", default=suppressed, help="reviewed OCI container image reference")
    paths.add_argument("--work-dir", type=Path, default=suppressed, help="Nextflow work directory; default: OUTPUT/.tumorquantai-work")
    paths.add_argument("--cache-dir", type=Path, default=suppressed, help="host cache root; default: a directory beside OUTPUT")
    paths.add_argument("--hf-cache", type=Path, default=suppressed, help="host Hugging Face cache directory")
    paths.add_argument("--histoplus-cache", type=Path, default=suppressed, help="host HistoPLUS weight-cache directory")
    paths.add_argument("--token-file", type=Path, default=suppressed, help="authorized token file path; never a token value")

    status = subparsers.add_parser("status", help="summarize completed, failed, incomplete, excluded, and pending samples")
    status.add_argument("output", type=Path, help="TumorQuantAI output directory")
    status.add_argument("--json", action="store_true", help="print redacted machine-readable JSON")

    report = subparsers.add_parser("report", help="generate START_HERE.html and JSON summary")
    report.add_argument("output", type=Path, help="TumorQuantAI output directory")
    report.add_argument("--json", action="store_true", help="also print the machine-readable summary")

    quickstart = subparsers.add_parser("quickstart", help="prepare and optionally run public Zenodo sample 022")
    quickstart.add_argument(
        "--output", type=Path,
        help="tutorial root (default: ../tumorquantai-quickstart-one-wsi)"
    )
    mode = quickstart.add_mutually_exclusive_group()
    mode.add_argument("--dry-run", action="store_true", help="print the bounded one-slide plan; do not download")
    mode.add_argument("--download-only", action="store_true", help="download and verify only sample 022")
    mode.add_argument("--convert-only", action="store_true", help="convert an already downloaded sample 022")
    mode.add_argument("--no-inference", action="store_true", help="download, convert, and inspect; do not infer")
    add_execution_profile_options(quickstart)
    add_execution_backend_options(quickstart)
    quickstart.add_argument("--seed", type=int, default=core.DEFAULT_SEED)
    quickstart.add_argument("--token-file", type=Path, help=argparse.SUPPRESS)
    quickstart.add_argument("--local-weight", type=Path, help="authorized local HistoPLUS weight file")
    return parser


def resolve_profile(requested: str, backend: str = "docker") -> str:
    if requested != "auto":
        return requested
    if backend in {"conda", "local"}:
        return "cpu"
    if shutil.which("nvidia-smi"):
        result = subprocess.run(
            ["nvidia-smi", "--query-gpu=name", "--format=csv,noheader"],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False,
        )
        if result.returncode == 0:
            if backend == "singularity":
                return "gpu"
            if backend == "docker" and shutil.which("docker"):
                daemon = subprocess.run(
                    ["docker", "info", "--format", "{{json .Runtimes}}"],
                    text=True, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                    check=False,
                )
                if daemon.returncode == 0 and "nvidia" in daemon.stdout.lower():
                    return "gpu"
    return "cpu"


def print_storage_plan(storage: dict[str, Any], estimates: dict[str, int]) -> None:
    print("Storage preflight:")
    print(f"  mount:      {storage['mount']['target']} ({storage['mount']['filesystem']})")
    print(f"  free:       {core.format_bytes(storage['free_bytes'])}")
    for name, amount in estimates.items():
        print(f"  {name + ':':<11} {core.format_bytes(amount)} estimated")
    print(f"  work/output on same filesystem: {'yes' if storage['same_filesystem'] else 'no'}")


def validate_expert_args(arguments: Sequence[str]) -> None:
    for argument in arguments:
        if not argument.startswith("-"):
            continue
        name = (
            argument.split("=", 1)[0].lstrip("-")
            .replace("-", "_").replace(".", "_")
        )
        if any(marker in name.lower() for marker in (
            "token", "secret", "password", "passwd", "credential", "api_key", "apikey"
        )):
            raise core.TumorQuantAIError(
                "Expert passthrough cannot accept credential-like options; configure a token file or authorized local weight instead.",
                core.EXIT_USAGE,
            )
        if name in PROTECTED_EXPERT_OPTIONS or name.startswith("process_"):
            raise core.TumorQuantAIError(
                f"Expert passthrough cannot override protected option {argument.split('=', 1)[0]!r}; use the documented run option or direct run.sh.",
                core.EXIT_USAGE,
            )


