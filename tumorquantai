if yaml is not None:
    class _UniqueKeyLoader(yaml.SafeLoader):
        """Safe YAML loader that refuses ambiguous duplicate mappings."""


    def _construct_unique_mapping(
        loader: Any, node: Any, deep: bool = False,
    ) -> dict[Any, Any]:
        result: dict[Any, Any] = {}
        for key_node, value_node in node.value:
            key = loader.construct_object(key_node, deep=deep)
            if key in result:
                raise ValueError(f"duplicate parameter key {key!r}")
            result[key] = loader.construct_object(value_node, deep=deep)
        return result


    _UniqueKeyLoader.add_constructor(
        yaml.resolver.BaseResolver.DEFAULT_MAPPING_TAG,
        _construct_unique_mapping,
    )
else:
    class _UniqueKeyLoader:  # pragma: no cover - used only by bootstrap install
        pass


def _unique_json_object(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise ValueError(f"duplicate parameter key {key!r}")
        result[key] = value
    return result


def _parameter_error(message: str) -> core.TumorQuantAIError:
    return core.TumorQuantAIError(message, core.EXIT_USAGE)


def _load_parameter_file(path: Path) -> dict[str, Any]:
    parameter_file = path.expanduser().resolve()
    try:
        text = parameter_file.read_text(encoding="utf-8")
    except OSError as exc:
        raise _parameter_error(f"Could not read parameter file: {exc}") from exc
    suffix = parameter_file.suffix.lower()
    if yaml is None and suffix != ".json":
        raise _parameter_error(
            "YAML support is not installed. Run 'tumorquantai install --docker' "
            "or use a JSON parameter file."
        )
    try:
        if suffix == ".json":
            data = json.loads(text, object_pairs_hook=_unique_json_object)
        elif suffix in {".yaml", ".yml"}:
            assert yaml is not None
            data = yaml.load(text, Loader=_UniqueKeyLoader)
        else:
            try:
                data = json.loads(text, object_pairs_hook=_unique_json_object)
            except (json.JSONDecodeError, ValueError):
                if yaml is None:
                    raise _parameter_error(
                        "The parameter file is not JSON and YAML support is unavailable."
                    )
                data = yaml.load(text, Loader=_UniqueKeyLoader)
    except (json.JSONDecodeError, ValueError) as exc:
        raise _parameter_error(f"Invalid parameter file: {exc}") from exc
    except Exception as exc:
        if yaml is not None and isinstance(exc, yaml.YAMLError):
            raise _parameter_error(f"Invalid parameter file: {exc}") from exc
        raise
    if data is None:
        data = {}
    if not isinstance(data, Mapping):
        raise _parameter_error("Parameter file must contain a top-level mapping.")
    if set(data) == {"params"}:
        data = data["params"]
        if not isinstance(data, Mapping):
            raise _parameter_error("The parameter-file 'params' value must be a mapping.")

    normalized: dict[str, Any] = {}
    for raw_key, value in data.items():
        if not isinstance(raw_key, str):
            raise _parameter_error("Every parameter-file key must be a string.")
        key = raw_key.replace("-", "_")
        if key in normalized:
            raise _parameter_error(
                f"Parameter file defines {key!r} more than once after key normalization."
            )
        normalized[key] = value

    allowed = set(PUBLIC_PARAMETER_OPTIONS) | set(LAUNCHER_DEFAULTS)
    internal = sorted(set(normalized) & set(INTERNAL_SCHEMA_PARAMETERS))
    if internal:
        raise _parameter_error(
            "Internal parameters cannot be set through tumorquantai: "
            + ", ".join(internal)
        )
    unknown = sorted(set(normalized) - allowed)
    if unknown:
        raise _parameter_error(
            "Unknown parameter-file key(s): " + ", ".join(unknown)
        )
    return normalized


def _schema_type_matches(value: Any, expected: str) -> bool:
    if expected == "null":
        return value is None
    if expected == "boolean":
        return isinstance(value, bool)
    if expected == "integer":
        return isinstance(value, int) and not isinstance(value, bool)
    if expected == "number":
        return (
            isinstance(value, (int, float))
            and not isinstance(value, bool)
            and math.isfinite(float(value))
        )
    if expected == "string":
        return isinstance(value, str)
    if expected == "array":
        return isinstance(value, list)
    if expected == "object":
        return isinstance(value, Mapping)
    return False


def _schema_validation_error(value: Any, specification: Mapping[str, Any]) -> str | None:
    if "oneOf" in specification:
        matches = [
            candidate for candidate in specification["oneOf"]
            if _schema_validation_error(value, candidate) is None
        ]
        if len(matches) != 1:
            return "does not match exactly one allowed form"
        return None

    expected = specification.get("type")
    expected_types = [expected] if isinstance(expected, str) else list(expected or [])
    if expected_types and not any(
        _schema_type_matches(value, expected_type) for expected_type in expected_types
    ):
        return "must have type " + " or ".join(expected_types)
    if value is None:
        return None
    if "enum" in specification and value not in specification["enum"]:
        return "must be one of " + ", ".join(map(str, specification["enum"]))
    if isinstance(value, str):
        if len(value) < int(specification.get("minLength", 0)):
            return f"must contain at least {specification['minLength']} character(s)"
        pattern = specification.get("pattern")
        if pattern and re.search(str(pattern), value) is None:
            return f"must match {pattern}"
    if (
        isinstance(value, (int, float))
        and not isinstance(value, bool)
        and math.isfinite(float(value))
    ):
        if "minimum" in specification and value < specification["minimum"]:
            return f"must be at least {specification['minimum']}"
        if "maximum" in specification and value > specification["maximum"]:
            return f"must be at most {specification['maximum']}"
        if "exclusiveMinimum" in specification and value <= specification["exclusiveMinimum"]:
            return f"must be greater than {specification['exclusiveMinimum']}"
        if "exclusiveMaximum" in specification and value >= specification["exclusiveMaximum"]:
            return f"must be less than {specification['exclusiveMaximum']}"
    if isinstance(value, list):
        if len(value) < int(specification.get("minItems", 0)):
            return f"must contain at least {specification['minItems']} item(s)"
        item_specification = specification.get("items")
        if item_specification:
            for index, item in enumerate(value):
                error = _schema_validation_error(item, item_specification)
                if error:
                    return f"item {index + 1} {error}"
    return None


def _validate_launcher_parameter(name: str, value: Any) -> None:
    if name == "preset" and value not in {"smoke", "fast", "full"}:
        raise _parameter_error("Parameter 'preset' must be smoke, fast, or full.")
    if name == "profile" and value not in {"auto", "gpu", "cpu", "local"}:
        raise _parameter_error("Parameter 'profile' must be auto, gpu, cpu, or local.")
    if name == "backend" and value not in {"docker", "singularity", "conda", "local"}:
        raise _parameter_error("Parameter 'backend' must be docker, singularity, conda, or local.")
    if name == "resume" and not isinstance(value, bool):
        raise _parameter_error("Parameter 'resume' must be a boolean.")
    if name == "sample" and value is not None and not isinstance(value, str):
        raise _parameter_error("Parameter 'sample' must be a string or null.")
    if name in LAUNCHER_PATH_PARAMETERS and value is not None:
        if not isinstance(value, (str, Path)) or not str(value):
            raise _parameter_error(f"Parameter {name!r} must be a non-empty path or null.")


def _available_memory_default() -> str:
    memory_gb = 16
    try:
        available_kib = int(next(
            line.split()[1]
            for line in Path("/proc/meminfo").read_text(encoding="utf-8").splitlines()
            if line.startswith("MemAvailable:")
        ))
        memory_gb = max(4, min(16, available_kib // 1024 // 1024))
    except (OSError, StopIteration, ValueError):
        pass
    return f"{memory_gb} GB"


def _preset_defaults(preset: str) -> dict[str, Any]:
    defaults: dict[str, Any] = {
        "percent_slide": {"smoke": 1.0, "fast": 10.0, "full": 100.0}[preset],
        "cpus": min(4, max(1, os.cpu_count() or 1)),
        "memory": _available_memory_default(),
        "max_parallel_slides": 1,
        "num_workers": 2,
    }
    if preset == "smoke":
        defaults["continue_on_error"] = False
    return defaults


def compatible_device_for_profile(
    profile: str, device: str, *, schema_default: bool,
) -> str:
    """Return the effective device or reject an impossible profile pairing."""
    if schema_default:
        if profile == "gpu":
            return "cuda"
        if profile in {"cpu", "local"}:
            return "cpu"
        return device
    if profile == "cpu" and (
        device == "gpu" or device.startswith("cuda")
    ):
        raise _parameter_error(
            f"Execution profile 'cpu' is incompatible with device {device!r}."
        )
    if profile == "gpu" and device == "cpu":
        raise _parameter_error(
            "Execution profile 'gpu' is incompatible with device 'cpu'."
        )
    return device


def explicit_run_parameter_keys(arguments: Sequence[str]) -> set[str]:
    """Return canonical keys explicitly represented on a parsed run command."""
    keys = {"input_dir", "output_dir"}
    option_to_key = {
        option: key
        for key, options in {
            **PUBLIC_PARAMETER_OPTIONS, **LAUNCHER_PARAMETER_OPTIONS,
        }.items()
        for option in options
        if option.startswith("--")
    }
    for argument in arguments[1:]:
        if not argument.startswith("--"):
            continue
        option = argument.split("=", 1)[0]
        key = option_to_key.get(option)
        if key:
            keys.add(key)
    return keys


def _namespace_explicit_keys(args: argparse.Namespace) -> set[str]:
    """Best-effort compatibility for callers that construct a Namespace."""
    result = {"input_dir", "output_dir"}
    values = vars(args)
    for key in PUBLIC_PARAMETER_OPTIONS:
        destination = SCHEMA_PARAMETER_DESTINATIONS.get(key, key)
        if destination not in values or values[destination] is None:
            continue
        if key == "slide_patterns" and not values[destination]:
            continue
        result.add(key)
    for key in LAUNCHER_DEFAULTS:
        if key in values and values[key] is not None:
            result.add(key)
    if "no_resume" in values:
        result.add("resume")
    return result


def resolve_run_parameters(
    args: argparse.Namespace, explicit_keys: set[str] | None = None,
) -> argparse.Namespace:
    """Apply defaults, preset, parameter-file, and explicit-CLI precedence."""
    if getattr(args, "_configuration_resolved", False):
        return args
    explicit = set(explicit_keys or _namespace_explicit_keys(args))
    raw = vars(args)
    parameter_values: dict[str, Any] = {}
    parameter_path = raw.get("params_file")
    if parameter_path is not None:
        parameter_values = _load_parameter_file(Path(parameter_path))

    launcher = copy.deepcopy(LAUNCHER_DEFAULTS)
    for key in LAUNCHER_DEFAULTS:
        if key in parameter_values:
            _validate_launcher_parameter(key, parameter_values[key])
            launcher[key] = parameter_values[key]
    for key in explicit & set(LAUNCHER_DEFAULTS):
        if key == "resume" and "resume" not in raw and "no_resume" in raw:
            value = not bool(raw["no_resume"])
        else:
            value = raw.get(key)
        _validate_launcher_parameter(key, value)
        launcher[key] = value

    preset = launcher["preset"]
    public = {
        key: copy.deepcopy(specification.get("default"))
        for key, specification in SCHEMA_PROPERTIES.items()
        if key not in INTERNAL_SCHEMA_PARAMETERS
    }
    sources = {key: "schema default" for key in public}
    for key, value in _preset_defaults(preset).items():
        public[key] = value
        sources[key] = f"{preset} preset"
    for key in PUBLIC_PARAMETER_OPTIONS:
        if key in parameter_values:
            public[key] = parameter_values[key]
            sources[key] = "parameter file"
    for key in explicit & set(PUBLIC_PARAMETER_OPTIONS):
        destination = SCHEMA_PARAMETER_DESTINATIONS.get(key, key)
        if destination not in raw:
            continue
        value = raw[destination]
        if isinstance(value, Path):
            value = str(value)
        public[key] = value
        sources[key] = "explicit CLI"

    for key, value in public.items():
        if isinstance(value, Path):
            value = str(value)
            public[key] = value
        error = _schema_validation_error(value, SCHEMA_PROPERTIES[key])
        if error:
            raise _parameter_error(f"Invalid value for parameter {key!r}: {error}.")
    if not public["input_dir"] or not public["output_dir"]:
        raise _parameter_error("Parameters 'input_dir' and 'output_dir' are required.")

    public["device"] = compatible_device_for_profile(
        launcher["profile"],
        str(public["device"]),
        schema_default=sources["device"] == "schema default",
    )

    patterns = public["slide_patterns"]
    if isinstance(patterns, str):
        patterns = [item.strip() for item in patterns.split(",") if item.strip()]
    if not patterns:
        raise _parameter_error("Parameter 'slide_patterns' must contain a non-empty pattern.")
    public["slide_patterns"] = patterns

    for key in LAUNCHER_PATH_PARAMETERS:
        value = launcher[key]
        launcher[key] = Path(value) if value is not None else None
    for key in PUBLIC_PATH_PARAMETERS:
        value = public[key]
        public[key] = Path(value) if value is not None else None

    for key, value in public.items():
        setattr(args, key, value)
    args.input = public["input_dir"]
    args.output = public["output_dir"]
    args.sample_sheet = public["sample_sheet"]
    args.pattern = list(public["slide_patterns"])
    args.source_mpp = public["slide_mpp"]
    args.seed = public["patch_random_seed"]
    args.local_weight = public["histoplus_weight_file"]
    for key, value in launcher.items():
        setattr(args, key, value)
    args.no_resume = not launcher["resume"]
    args.params_file = Path(parameter_path) if parameter_path is not None else None
    args.public_parameters = public
    args._parameter_sources = sources
    args._configuration_resolved = True
    return args


