PROTECTED_EXPERT_OPTIONS = {
    "c", "config", "params_file", "with_apptainer", "with_conda",
    "with_docker", "with_mpi", "with_podman", "with_singularity",
    "without_docker", "executor", "process_executor",
    "container_image", "continue_on_error", "device", "docker_run_options",
